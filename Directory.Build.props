<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>TCDev</Authors>
    <Company>TCDev</Company>
    <Product>GameSync</Product>
    <Copyright>Copyright © TCDev</Copyright>

    <!-- Semantic version (MAJOR.MINOR.PATCH). Inno Setup / About use the same value. -->
    <Version>1.2.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <!--
      Publisher identity is configurable for production signing.
      Override at build time, e.g.:
        -p:GameSyncPublisher="CN=Your Name, O=Your Org"
        -p:GameSyncPublisherDisplayName="Your Org"
    -->
    <GameSyncPublisher Condition="'$(GameSyncPublisher)' == ''">CN=GameSync</GameSyncPublisher>
    <GameSyncPublisherDisplayName Condition="'$(GameSyncPublisherDisplayName)' == ''">GameSync</GameSyncPublisherDisplayName>
    <GameSyncPackageIdentityName Condition="'$(GameSyncPackageIdentityName)' == ''">GameSync.App</GameSyncPackageIdentityName>
  </PropertyGroup>
</Project>
